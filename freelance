        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #0d1117; color: #c9d1d9; line-height: 1.6; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
        
        /* Hero Section */
        .hero { display: flex; align-items: center; justify-content: space-between; padding: 60px 0; gap: 40px; flex-wrap: wrap-reverse; }
        .hero-text { flex: 1; min-width: 300px; }
        .hero-text h1 { font-size: 3rem; color: #58a6ff; font-weight: 800; line-height: 1.2; text-transform: uppercase; margin-bottom: 15px; }
        .hero-text p.tagline { font-size: 1.2rem; color: #8b949e; margin-bottom: 25px; font-style: italic; border-left: 3px solid #00ffcc; padding-left: 12px; }
        .hero-img { flex: 1; display: flex; justify-content: center; min-width: 280px; }
        .hero-img img { width: 280px; height: 280px; border-radius: 50%; object-fit: cover; border: 4px solid #00ffcc; box-shadow: 0 0 25px rgba(0, 255, 204, 0.3); }
        
        /* Section Styles */
        h2.section-title { font-size: 2rem; color: #00ffcc; text-align: center; margin: 50px 0 25px; border-bottom: 1px solid #30363d; padding-bottom: 10px; }
        
        /* About Us Section */
        .about-card { background: #161b22; padding: 30px; border-radius: 12px; border: 1px solid #30363d; }
        .about-card p { margin-bottom: 15px; font-size: 1.05rem; color: #e6edf3; }
        
        /* Services Section */
        .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .service-card { background: #161b22; padding: 20px; border-radius: 10px; border: 1px solid #30363d; text-align: center; transition: 0.3s; }
        .service-card:hover { border-color: #00ffcc; transform: translateY(-5px); }
        .service-card h3 { color: #58a6ff; margin-bottom: 10px; }

        /* Video Showcase Grid */
        .video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .video-card { background: #161b22; border-radius: 10px; padding: 12px; border: 1px solid #30363d; text-align: center; }
        iframe { width: 100%; height: 210px; border-radius: 8px; border: none; }

        /* Buttons & Floating Chat */
        .yt-btn { display: inline-block; padding: 12px 25px; background: #FF0000; color: #fff; font-weight: bold; text-decoration: none; border-radius: 30px; margin-top: 10px; }
